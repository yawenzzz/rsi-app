{
  "name": "@yawenzzz/dsh-rsi",
  "version": "0.1.0",
  "description": "Independent RSI project agents, cognitive workflows and evidence on official DeepSeek Harness",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.9.0",
    "dsh": "0.2.1-rc.3"
  },
  "main": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/types/client/index.d.ts",
      "default": "./dist/client.js"
    },
    "./harness": {
      "types": "./dist/types/harness/index.d.ts",
      "default": "./dist/harness/index.js"
    },
    "./paper": {
      "types": "./dist/types/runtime/index.d.ts",
      "default": "./dist/runtime/index.js"
    },
    "./agent": {
      "types": "./dist/types/agent/index.d.ts",
      "default": "./dist/agent/index.js"
    },
    "./package.json": "./package.json",
    "./bundles/*": "./bundles/*",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "dist",
    "bundles",
    "locale",
    "docs",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./bundles/app.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-renderer"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:smoke": "node scripts/packed-smoke.mjs",
    "pack": "npm pack",
    "prepack": "npm run build",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "setup": "node scripts/setup.mjs",
    "start": "node scripts/start.mjs",
    "check:standalone": "node scripts/check-standalone.mjs"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "0.6.0",
    "js-yaml": "4.2.0",
    "proper-lockfile": "4.1.2",
    "zod": "4.4.3"
  },
